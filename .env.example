# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY / VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps JavaScript API in the browser.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Cloud SQL PostgreSQL connection environment variables (provided by runtime)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Web Push VAPID keys for background mobile UV notifications
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Optional Local/Cloud Weather Station integration (server-side only)
WISECONN_API_KEY=""
WISECONN_FARM_ID=""
WEATHER_STATION_INGEST_SECRET=""
ECOWITT_APP_KEY=""
ECOWITT_API_KEY=""
ECOWITT_MAC=""
DAVIS_API_KEY=""
DAVIS_API_SECRET=""
DAVIS_STATION_ID=""
